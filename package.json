  "type": "module",
  "description": "把超大图先降采样、把不支持的格式转成 PNG，并在附件入库前纠正标错的图片类型——一轮对话内解决。",
  "license": "MIT",
  "author": "SugarOriginal",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image",
    "convert",
    "downscale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yimengsuper2432/dsh-auto-convert.git"
  },
  "homepage": "https://github.com/yimengsuper2432/dsh-auto-convert#readme",
  "bugs": {
    "url": "https://github.com/yimengsuper2432/dsh-auto-convert/issues"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
