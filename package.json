{
  "name": "dsh-auto-convert",
  "version": "0.6.0",
  "type": "module",
  "description": "读图、读文档之前先把文件处理成能读的样子：超大图降采样、BMP/TIFF 转 PNG、docx/xlsx/pptx/pdf/csv/html 就地转成 Markdown，一轮对话就出结论。",
  "license": "MIT",
  "author": "SugarOriginal",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image",
    "downscale",
    "markdown",
    "docx",
    "xlsx",
    "pptx",
    "pdf",
    "pdf-to-markdown",
    "office",
    "convert"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yimengsuper2432/dsh-auto-convert.git"
  },
  "homepage": "https://github.com/yimengsuper2432/dsh-auto-convert#readme",
  "bugs": {
    "url": "https://github.com/yimengsuper2432/dsh-auto-convert/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}